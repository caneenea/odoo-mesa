<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="guest_form_view" model="ir.ui.view">
            <field name="name">mesa.guest.form</field>
            <field name="model">mesa.guest</field>
            <field name="arch" type="xml">
                <form string="Guest">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Name"/>
                                <field name="surname" placeholder="Surname"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="birth_date"/>
                                <field name="regular"/>
                            </group>
                            <group>
                                <field name="preferred_location"/>
                                <field name="notes"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="guest_tree_view" model="ir.ui.view">
            <field name="name">mesa.guest.tree</field>
            <field name="model">mesa.guest</field>
            <field name="arch" type="xml">
                <tree string="Guest">
                    <field name="name"/>
                    <field name="surname"/>
                </tree>
            </field>
        </record>

        <record id="guest_search_view" model="ir.ui.view">
            <field name="name">mesa.guest.search</field>
            <field name="model">mesa.guest</field>
            <field name="arch" type="xml">
                <search string="Guest">
                    <field name="name"/>
                    <field name="surname"/>
                </search>
            </field>
        </record>

        <record id="guest_act_window" model="ir.actions.act_window">
            <field name="name">Guest</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mesa.guest</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new ModelTitle.
                </p>
            </field>
        </record>

        <menuitem name="Guest" id="guest_menu" parent="store_root" action="guest_act_window" sequence = "30"/>

    </data>
</odoo>