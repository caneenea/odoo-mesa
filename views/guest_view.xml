<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="guest_form_view" model="ir.ui.view">
            <field name="name">mesa.guest.form</field>
            <field name="model">mesa.guest</field>
            <field name="arch" type="xml">
                <form string="Guest">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Name"/>
                                <field name="surname" placeholder="Surname"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="birth_date"/>
                                <field name="preferred_location"/>
                                <field name="regular" widget="boolean_toggle"/>
                                <field name="points"/>
                            </group>
                        </group>
                        <group string="Notes">
                            <field name="notes" nolabel="1" placeholder="Allergies, preferences, or anything staff should know..."/>
                        </group>
                        <notebook>
                            <page string="Reservations">
                                <field name="reservation_ids">
                                    <tree>
                                        <field name="reservation_time"/>
                                        <field name="party_size"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="guest_tree_view" model="ir.ui.view">
            <field name="name">mesa.guest.tree</field>
            <field name="model">mesa.guest</field>
            <field name="arch" type="xml">
                <tree string="Guests">
                    <field name="name"/>
                    <field name="surname"/>
                    <field name="preferred_location"/>
                    <field name="regular" widget="boolean_toggle"/>
                    <field name="points" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="guest_search_view" model="ir.ui.view">
            <field name="name">mesa.guest.search</field>
            <field name="model">mesa.guest</field>
            <field name="arch" type="xml">
                <search string="Guests">
                    <field name="name"/>
                    <field name="surname"/>
                    <field name="preferred_location"/>
                    <separator/>
                    <filter string="Regular Guests" name="filter_regular" domain="[('regular', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Preferred Location" name="group_by_location" context="{'group_by': 'preferred_location'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="guest_act_window" model="ir.actions.act_window">
            <field name="name">Guests</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mesa.guest</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="guest_search_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first guest
                </p>
                <p>
                    Guests are people who dine at the restaurant and can be linked to reservations.
                </p>
            </field>
        </record>

        <menuitem name="Guest" id="guest_menu" parent="guests_menu" action="guest_act_window" sequence="10"/>

    </data>
</odoo>
