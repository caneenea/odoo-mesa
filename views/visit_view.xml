<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="visit_form_view" model="ir.ui.view">
            <field name="name">mesa.visit.form</field>
            <field name="model">mesa.visit</field>
            <field name="arch" type="xml">
                <form string="Visit">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="time_opened" placeholder="Time Opened"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="time_closed"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="visit_tree_view" model="ir.ui.view">
            <field name="name">mesa.visit.tree</field>
            <field name="model">mesa.visit</field>
            <field name="arch" type="xml">
                <tree string="Visit">
                    <field name="time_opened"/>
                    <field name="time_closed"/>
                </tree>
            </field>
        </record>

        <record id="visit_search_view" model="ir.ui.view">
            <field name="name">mesa.visit.search</field>
            <field name="model">mesa.visit</field>
            <field name="arch" type="xml">
                <search string="Visit">
                    <field name="time_opened"/>
                    <field name="time_closed"/>


                </search>
            </field>
        </record>

        <record id="visit_act_window" model="ir.actions.act_window">
            <field name="name">Visit</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mesa.visit</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new ModelTitle.
                </p>
            </field>
        </record>

        <menuitem name="Visit" id="visit_menu" parent="store_root" action="visit_act_window" sequence = "60"/>

    </data>
</odoo>