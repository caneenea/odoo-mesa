<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="station_form_view" model="ir.ui.view">
            <field name="name">mesa.station.form</field>
            <field name="model">mesa.station</field>
            <field name="arch" type="xml">
                <form string="Station">
                    <sheet>
                        <div class="oe_title">
                        </div>
                        <group>
                            <group>
                                <field name="type"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="station_tree_view" model="ir.ui.view">
            <field name="name">mesa.station.tree</field>
            <field name="model">mesa.station</field>
            <field name="arch" type="xml">
                <tree string="Station">
                    <field name="type"/>
                </tree>
            </field>
        </record>

        <record id="station_search_view" model="ir.ui.view">
            <field name="name">mesa.station.search</field>
            <field name="model">mesa.station</field>
            <field name="arch" type="xml">
                <search string="Station">
                    <field name="type"/>
                </search>
            </field>
        </record>

        <record id="station_act_window" model="ir.actions.act_window">
            <field name="name">Station</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mesa.station</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Station.
                </p>
            </field>
        </record>

        <menuitem name="Station" id="station_menu" parent="store_root" action="station_act_window" sequence = "90"/>

    </data>
</odoo>