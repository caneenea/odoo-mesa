<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="station_form_view" model="ir.ui.view">
            <field name="name">mesa.station.form</field>
            <field name="model">mesa.station</field>
            <field name="arch" type="xml">
                <form string="Station">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="type"/>
                            </h1>
                        </div>
                        <notebook>
                            <page string="Menu Items">
                                <field name="menu_item_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="price"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="station_tree_view" model="ir.ui.view">
            <field name="name">mesa.station.tree</field>
            <field name="model">mesa.station</field>
            <field name="arch" type="xml">
                <tree string="Stations">
                    <field name="type"/>
                </tree>
            </field>
        </record>

        <record id="station_search_view" model="ir.ui.view">
            <field name="name">mesa.station.search</field>
            <field name="model">mesa.station</field>
            <field name="arch" type="xml">
                <search string="Stations">
                    <field name="type"/>
                </search>
            </field>
        </record>

        <record id="station_act_window" model="ir.actions.act_window">
            <field name="name">Stations</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mesa.station</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="station_search_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first station
                </p>
                <p>
                    Stations represent the kitchen prep areas, such as saute, broil, or dessert.
                </p>
            </field>
        </record>

        <menuitem name="Station" id="station_menu" parent="floor_menu" action="station_act_window" sequence="20"/>

    </data>
</odoo>
