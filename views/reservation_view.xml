<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="reservation_form_view" model="ir.ui.view">
            <field name="name">mesa.reservation.form</field>
            <field name="model">mesa.reservation</field>
            <field name="arch" type="xml">
                <form string="Reservation">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="reservation_name" placeholder="Reservation Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="party_size"/>
                                <field name="reservation_time"/>

                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="reservation_tree_view" model="ir.ui.view">
            <field name="name">mesa.reservation.tree</field>
            <field name="model">mesa.reservation</field>
            <field name="arch" type="xml">
                <tree string="Reservation">
                    <field name="reservation_name"/>
                    <field name="reservation_time"/>
                    <field name="party_size"/>
                </tree>
            </field>
        </record>

        <record id="reservation_search_view" model="ir.ui.view">
            <field name="name">mesa.reservation.search</field>
            <field name="model">mesa.reservation</field>
            <field name="arch" type="xml">
                <search string="Reservation">
                    <field name="reservation_name"/>
                    <field name="reservation_time"/>
                    <field name="party_size"/>
                </search>
            </field>
        </record>

        <record id="reservation_act_window" model="ir.actions.act_window">
            <field name="name">Reservation</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mesa.reservation</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Reservation.
                </p>
            </field>
        </record>

        <menuitem name="Reservation" id="reservation_menu" parent="store_root" action="reservation_act_window" sequence = "50"/>

    </data>
</odoo>