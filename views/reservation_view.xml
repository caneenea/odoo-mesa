<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="reservation_form_view" model="ir.ui.view">
            <field name="name">mesa.reservation.form</field>
            <field name="model">mesa.reservation</field>
            <field name="arch" type="xml">
                <form string="Reservation">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="guest_id" placeholder="Guest"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="guest_name" placeholder="Name to book under, if no guest is linked"/>
                                <field name="party_size"/>
                            </group>
                            <group>
                                <field name="reservation_time"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Visits">
                                <field name="visit_ids">
                                    <tree>
                                        <field name="time_opened"/>
                                        <field name="time_closed"/>
                                        <field name="table_id"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="reservation_tree_view" model="ir.ui.view">
            <field name="name">mesa.reservation.tree</field>
            <field name="model">mesa.reservation</field>
            <field name="arch" type="xml">
                <tree string="Reservations">
                    <field name="reservation_time"/>
                    <field name="guest_id"/>
                    <field name="guest_name"/>
                    <field name="party_size"/>
                </tree>
            </field>
        </record>

        <record id="reservation_search_view" model="ir.ui.view">
            <field name="name">mesa.reservation.search</field>
            <field name="model">mesa.reservation</field>
            <field name="arch" type="xml">
                <search string="Reservations">
                    <field name="guest_id"/>
                    <field name="guest_name"/>
                    <field name="reservation_time"/>
                    <separator/>
                    <filter string="Today" name="filter_today"
                            domain="[('reservation_time', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                     ('reservation_time', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                    <group expand="0" string="Group By">
                        <filter string="Guest" name="group_by_guest" context="{'group_by': 'guest_id'}"/>
                        <filter string="Reservation Date" name="group_by_date" context="{'group_by': 'reservation_time:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="reservation_act_window" model="ir.actions.act_window">
            <field name="name">Reservations</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mesa.reservation</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="reservation_search_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first reservation
                </p>
                <p>
                    Reservations can be booked under a known guest or a name for walk-in bookings.
                </p>
            </field>
        </record>

        <menuitem name="Reservation" id="reservation_menu" parent="guests_menu" action="reservation_act_window" sequence="20"/>

    </data>
</odoo>
