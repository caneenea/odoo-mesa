<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="position_form_view" model="ir.ui.view">
            <field name="name">mesa.position.form</field>
            <field name="model">mesa.position</field>
            <field name="arch" type="xml">
                <form string="Position">
                    <sheet>
                        <group>
                            <group>
                                <field name="title" placeholder="Title"/>
                                <field name="department"/>
                            </group>
                            <group>
                                <field name="base_pay"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Employees">
                                <field name="employee_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="surname"/>
                                        <field name="hire_date"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="position_tree_view" model="ir.ui.view">
            <field name="name">mesa.position.tree</field>
            <field name="model">mesa.position</field>
            <field name="arch" type="xml">
                <tree string="Positions">
                    <field name="title"/>
                    <field name="department"/>
                    <field name="base_pay"/>
                </tree>
            </field>
        </record>

        <record id="position_search_view" model="ir.ui.view">
            <field name="name">mesa.position.search</field>
            <field name="model">mesa.position</field>
            <field name="arch" type="xml">
                <search string="Positions">
                    <field name="title"/>
                    <field name="department"/>
                    <group expand="0" string="Group By">
                        <filter string="Department" name="group_by_department" context="{'group_by': 'department'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="position_act_window" model="ir.actions.act_window">
            <field name="name">Positions</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mesa.position</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="position_search_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first position
                </p>
                <p>
                    Positions define a job title, department, and base pay that employees are assigned to.
                </p>
            </field>
        </record>

        <menuitem name="Position" id="position_menu" parent="staffing_menu" action="position_act_window" sequence="20"/>

    </data>
</odoo>
