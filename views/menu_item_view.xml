<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="menu_item_form_view" model="ir.ui.view">
            <field name="name">mesa.menu_item.form</field>
            <field name="model">mesa.menu_item</field>
            <field name="arch" type="xml">
                <form string="Menu Item">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="price"/>
                                <field name="stock_qty"/>
                            </group>
                            <group>
                                <field name="station_id"/>
                                <field name="category_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="menu_item_tree_view" model="ir.ui.view">
            <field name="name">mesa.menu_item.tree</field>
            <field name="model">mesa.menu_item</field>
            <field name="arch" type="xml">
                <tree string="Menu Items">
                    <field name="name"/>
                    <field name="category_ids" widget="many2many_tags" optional="show"/>
                    <field name="station_id" optional="show"/>
                    <field name="price"/>
                    <field name="stock_qty" optional="hide"/>
                </tree>
            </field>
        </record>

        <record id="menu_item_search_view" model="ir.ui.view">
            <field name="name">mesa.menu_item.search</field>
            <field name="model">mesa.menu_item</field>
            <field name="arch" type="xml">
                <search string="Menu Items">
                    <field name="name"/>
                    <field name="category_ids"/>
                    <field name="station_id"/>
                    <field name="price"/>
                    <group expand="0" string="Group By">
                        <filter string="Category" name="group_by_category" context="{'group_by': 'category_ids'}"/>
                        <filter string="Station" name="group_by_station" context="{'group_by': 'station_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="menu_item_act_window" model="ir.actions.act_window">
            <field name="name">Menu Items</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mesa.menu_item</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="menu_item_search_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first menu item
                </p>
                <p>
                    Menu items are the dishes and drinks available to order, with their selling price.
                </p>
            </field>
        </record>

        <menuitem name="Menu Item" id="menu_item_menu" parent="menu_catalog_menu" action="menu_item_act_window" sequence="10"/>

    </data>
</odoo>
