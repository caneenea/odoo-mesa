<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="order_item_form_view" model="ir.ui.view">
            <field name="name">mesa.order_item.form</field>
            <field name="model">mesa.order_item</field>
            <field name="arch" type="xml">
                <form string="Order Item">
                    <sheet>
                        <div class="oe_title">
                        </div>
                        <group>
                            <group>
                                <field name="menu_item_id"/>
                                <field name="quantity"/>
                                <field name="order_id"/>
                            </group>
                            <group>
                                <field name="notes"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="order_item_tree_view" model="ir.ui.view">
            <field name="name">mesa.order_item.tree</field>
            <field name="model">mesa.order_item</field>
            <field name="arch" type="xml">
                <tree string="order_item">
                    <field name="menu_item_id"/>
                    <field name="quantity"/>
                    <field name="order_id"/>
                    <field name="notes"/>

                </tree>
            </field>
        </record>

        <record id="order_item_search_view" model="ir.ui.view">
            <field name="name">mesa.order_item.search</field>
            <field name="model">mesa.order_item</field>
            <field name="arch" type="xml">
                <search string="order_item">
                     <field name="menu_item_id"/>
                </search>
            </field>
        </record>

        <record id="order_item_act_window" model="ir.actions.act_window">
            <field name="name">Order Item</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mesa.order_item</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new OrderItem.
                </p>
            </field>
        </record>

        <menuitem name="Order Item" id="order_item_menu" parent="store_root" action="order_item_act_window" sequence = "110"/>

    </data>
</odoo>